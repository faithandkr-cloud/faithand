#48277;'&#50640; &#54644;&#45817;&#54616;&#45716; &#55176;&#48652;&#47532;&#50612; '&#53664;&#46972;&#53944; &#50500;&#46020;&#45208;&#51060;'(*)&#45716; &#48376;&#49436;&#50640;&#49436; &#52376;&#51020;&#51004;&#47196; &#46321;&#51109;&#54620;&#45796;. '&#53664;&#46972;'(*)&#45716; &#51088;&#51452; '&#50984;&#48277;'&#51004;&#47196; &#48264;&#50669;&#46104;&#51648;&#47564;, &#48372;&#45796; &#51221;&#54869;&#54616;&#44172;&#45716; '&#54616;&#45208;&#45784;&#51032; &#50616;&#50557; &#48177;&#49457;&#51012; &#50948;&#54644; &#51452;&#49888; &#44368;&#54984;'&#51060;&#46972;&#45716; &#51032;&#48120;&#47484; &#44032;&#51648;&#44256; &#51080;&#45796;. &#51060; &#45800;&#50612;&#51032; &#50612;&#44540; '&#50556;&#46972;'(*)&#45716; '&#45912;&#51648;&#45796;', '&#50136;&#45796;' &#46321;&#51032; &#51032;&#48120;&#47484; &#44032;&#51648;&#44256; &#51080;&#50612;&#49436;(BDB), '&#53664;&#46972;'&#46972;&#45716; &#54364;&#54788; &#49549;&#50640;&#45716; &#51648;&#49884;&#45208; &#44368;&#54984; &#46321;&#51032; &#51032;&#48120;&#44032; &#45236;&#54252;&#46108;&#45796;(J.Niehaus). &#50976;&#45796; &#48177;&#49457;&#51008; &#50984;&#48277;&#51012; &#48155;&#51008; &#51088;&#47196;&#49436; &#54616;&#45208;&#45784;&#51032; &#44032;&#47476;&#52840;&#50640; &#49692;&#51333;&#54644;&#50556; &#54664;&#51020;&#50640;&#46020; &#48520;&#44396;&#54616;&#44256; &#44536;&#47196;&#48512;&#53552; &#47680;&#50612;&#51276;&#51012; &#49104;&#47564; &#50500;&#45768;&#46972; &#51221;&#48152;&#45824;&#51032; &#44600;&#51012; &#44152;&#50632;&#45796;. </p><p><strong> &#9758;&#44536; &#50676;&#51312;&#51032; &#46384;&#46972;&#44032;&#45912; &#44144;&#51667; &#44163;&#50640; &#48120;&#54841;&#54616;&#50688;&#51020;&#51060;&#46972;</strong> - &#50500;&#47784;&#49828; &#45817;&#49884;&#51032; &#50976;&#45796; &#50773; &#50883;&#49884;&#50556;(&#50500;&#49324;&#47028;)&#45716; &#44536; &#48512;&#52828; &#50500;&#47560;&#49380;&#51032; &#47784;&#46304; &#54665;&#50948;&#45824;&#47196; &#50668;&#54840;&#