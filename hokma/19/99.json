3685;&#52824;]\r\n</p><p>&#48376;&#51208;&#51008; &#51452;&#54644;&#54616;&#44592;&#44032; &#49789;&#51648; &#50506;&#45796;. &#51648;&#44552;&#44620;&#51648; &#55128;&#47084;&#50724;&#45912; &#50612;&#46500; &#49324;&#49345;&#51032; &#55120;&#47492;&#51060; &#44049;&#51088;&#44592; &#48320;&#54868;&#47484; &#51068;&#51004;&#53412;&#45716; &#46319;&#54620; &#45712;&#45196;&#51012; &#51452;&#44592; &#46412;&#47928;&#51060;&#45796;. &#48376;&#51208;&#50640; &#45824;&#54620; &#45824;&#54364;&#51201;&#51064; &#51452;&#54644;&#45716; &#48376;&#51208; &#47568;&#48120;&#50640; &#45208;&#50724;&#45716; '&#44036;&#44396;'&#51032; &#44060;&#45392;&#51012; &#51473;&#49884;&#54616;&#50668; &#44396;&#50557;&#50640; &#45208;&#50724;&#45716; &#50689;&#50885;&#51201; &#51473;&#48372; &#44592;&#46020;&#51088;&#46308;&#51064; &#47784;&#49464;, &#50500;&#47200;, &#49324;&#47924;&#50648;&#51012; &#49548;&#44060;&#54616;&#45716; &#44396;&#51208;&#47196; &#48372;&#45716; &#44204;&#54644;&#46972; &#54624; &#49688; &#51080;&#45796;(Rosenmuller). &#47568;&#54616;&#51088;&#47732; &#51060;&#49828;&#46972;&#50648;&#51032; &#45824;&#54364;&#51201; &#51473;&#48372; &#44592;&#46020;&#51088;&#46308;&#51060;(<a class='bible' href='#b2.14.15'>Exo 14:15</a> ;<a class='bible' href='#b2.17.11'>Exo 17:11</a>  &#51060;&#54616;;32:11 &#51060;&#54616;;<a class='bible' href='#b4.12.13'>Num 12:13</a> ;<a class='bible' href='#b4.14.13'>Num 14:13</a>  &#51060;&#54616;;16:44-48;<a class='bible' href='#b9.7.8'>1Sa 7:8</a>  &#51060;&#54616; &#46321;&#51012; &#52280;&#51312;&#54616;&#46972;) &#44592;&#46020;&#54616;&#45768; &#54616;&#45208;&#45784;&#51060; &#44536; &#44592;&#46020;&#50640; &#51025;&#45813;&#54616;&#49512;&#45796;&#45716; &#49324;&#49892;&#51012; &#44053;&#51312;&#54620;&#45796;&#44256; &#48372;&#45716; &#44163;&#51060;&#45796;. &#44536;&#47084;&#45208; &#51060;&#50752;&#45716; &#45804;&#47532; &#48376; &#49884;&#54200; &#51204;&#52404;&#51032; &#47928;&#47589;, &#53945;&#55176; 1-5&#51208;&#51032;