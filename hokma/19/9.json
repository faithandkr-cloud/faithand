60;&#45796;. &#54616;&#45208;&#45784;&#51008; &#50501;&#51064;&#50640; &#45824;&#54644;&#49436;&#45716; &#48372;&#49688;(&#22577;&#35728;)&#54616;&#49884;&#45208; &#44216;&#49552;&#55176; &#44536;&#47484; &#51032;&#51648;&#54616;&#44256; &#52286;&#45716; &#51088;&#46308;&#51008; &#54872;&#45212; &#51473;&#50640; &#44592;&#50613;&#54616;&#49492;&#49436; &#44396;&#50896;&#54616;&#49888;&#45796;. &#50668;&#44592;&#50640; &#54616;&#45208;&#45784;&#51032; &#50577;&#47732;&#49457;&#51060; &#50516;&#49884;&#46104;&#50612; &#51080;&#45796;. </p><p><strong> &#9758;&#44032;&#45212;&#54620; &#51088;&#51032; &#48512;&#47476;&#51670;&#51020;&#51012; &#51082;&#51648; &#50500;&#45768;&#54616;&#49884;&#46020;&#45796;</strong> - '&#44032;&#45212;&#54620; &#51088;'&#46976; &#47928;&#51088; &#44536;&#45824;&#47196; '&#44032;&#45212;&#54620; &#51088;'&#47484; &#51032;&#48120;&#54624; &#49104;&#47564; &#50500;&#45768;&#46972; &#51008;&#50976;&#51201;&#51064; &#54364;&#54788;&#51004;&#47196;&#45716; &#50896;&#49688;&#46308;&#50640;&#44172; &#50517;&#51228;&#45817;&#54616;&#45716; &#51088;, &#44256;&#53685;&#45817;&#54616;&#45716; &#51088;&#44620;&#51648;&#46020; &#54252;&#54632;&#54616;&#45716; &#47568;&#51060;&#45796;(Rawlinson, Kay). &#50668;&#44592;&#49436;&#45716; &#54980;&#51088;&#51032; &#51032;&#48120;&#47196; &#49324;&#50857;&#46104;&#50632;&#45796;.\r\n</p>"},{"fromverse":13,"toverse":13,"data":"<p> <strong> &#49457; &#44221;. [&#49884;.9.13]\r\n</p></strong><p>  &#51452;&#51228;1: [&#44396;&#50896;&#51032; &#54616;&#45208;&#45784;&#44760; &#45824;&#54620; &#52268;&#49569;]\r\n</p><p>&#51452;&#51228;2: [&#44277;&#51032;&#47196;&#50864;&#49888; &#49900;&#54032;&#51452;]\r\n</p><p>&#52268;&#49569;&#51032; &#48516;&#50948;&#44592;&#50640;&#49436; &#44592;&#46020;&#51032; &#48516;&#50948;&#44592;&#47196; &#48148;&#45068;&#45716; &#51204;&#54872;&#51216;&#51060;&#45796;. </p><p><strong> &#9758;&#50668;&#54840;&#50752;&#50668; &#45208;&#47484; &#44557;&#55100;&#55176; &#50668;&#44592;