[{"fromverse":1,"toverse":1,"data":"<p> <strong> &#49457; &#44221;. [&#49884;.110.1]\r\n</p></strong><p>  &#51452;&#51228;1: [&#50773;&#44284; &#51228;&#49324;&#51109; &#46104;&#49888; &#44536;&#47532;&#49828;&#46020;]\r\n</p><p>&#51452;&#51228;2: [&#47700;&#49884;&#50556;&#51032; &#53685;&#52824;&#50752; &#49900;&#54032;]\r\n</p><p><strong> &#9758;&#50668;&#54840;&#50752;&#44760; &#45236; &#51452;&#50640;&#44172; &#47568;&#50432;&#54616;&#49884;&#44592;&#47484;</strong> - &#55176;&#48652;&#47532;&#50612; &#49457;&#44221; &#50896;&#47928;&#50640; '&#45796;&#50967;&#51032; &#49884;'&#46976; &#51228;&#47785;&#51060; &#44592;&#47197;&#46104;&#50612; &#51080;&#45796;. &#50668;&#44592;&#49436; '&#45236; &#51452;'&#45716; &#55176;&#48652;&#47532;&#50612; '&#50500;&#46020;&#45768;'(*)&#47484; &#48264;&#50669;&#54620; &#44163;&#51004;&#47196;&#49436; &#50526;&#51004;&#47196; &#45796;&#50967;&#51032; &#51088;&#49552;&#51004;&#47196; &#50724;&#49892; &#47700;&#49884;&#50556;&#47484; &#44032;&#47532;&#53416;&#45796;. &#48708;&#47197; &#47700;&#49884;&#50556;&#44032; &#45796;&#50967;&#51032; &#51088;&#49552;&#51060;&#44596; &#54616;&#51648;&#47564; &#44536;&#47532;&#49828;&#46020;&#45716; &#52380;&#49324;&#46308;&#48372;&#45796; &#50864;&#50900;&#54616;&#49888; &#48516;&#51004;&#47196;&#49436; &#52380;&#49324;&#46308;&#51012; &#48512;&#47532;&#49884;&#45716; &#54616;&#45208;&#45784;&#51060;&#49884;&#45796;(<a class='bible' href='#b58.1.13'>Heb 1:13</a> , <a class='bible' href='#b58.1.14'>Heb 1:14</a> ). &#50696;&#49688;&#44760;&#49436;&#45716; &#44536;&#47532;&#49828;&#46020;&#50640; &#45824;&#54620; &#48148;&#47532;&#49352;&#51064;&#46308;&#51032; &#47924;&#51648;&#47484; &#51648;&#51201;&#54616;&#44592; &#50948;&#54644; &#48376; &#49884; &#49436;&#46160;&#47484; &#51064;&#50857;&#54616;&#47732;&#49436;, &#44536;&#47532;&#49828;&#46020;&#44032; &#45796;&#50967;&#51032; &#51088;&#49552;&#51076;&#50640;&#46020; &#48520;&#44396;&#54616;&#44256; &#45796;&#50967;&#51060; &#50780; &