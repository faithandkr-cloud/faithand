; &#44053;&#44036;&#54664;&#45912; &#54980;&#44417;&#46308;&#51060;&#50632;&#45796;(16:21, 22). &#46384;&#46972;&#49436; &#45796;&#50967; &#50773;&#51060; &#51060;&#46308;&#51012; &#48324;&#49892;&#50640;&#45796; &#44032;&#46160;&#50612; &#44201;&#47532;&#49884;&#53020; &#45459;&#51008; &#44163;&#51008; &#51060;&#46308;&#51032; &#48520;&#44208;&#54632; &#46412;&#47928;&#51060;&#50632;&#45796;(Grotius). &#44536;&#47084;&#45208; &#54620;&#54200;&#51004;&#47196; &#45796;&#50967; &#50773;&#51008; &#49688;&#52824;&#47484; &#48276;&#54620; &#50668;&#51064;&#50640; &#44288;&#54620; &#54616;&#45208;&#45784;&#51032; &#50984;&#48277; &#51312;&#54637;(<a class='bible' href='#b5.9.1-5.9.4'>Deu 9:1-4</a> )&#51012; &#46384;&#46972; &#51060;&#50752; &#44057;&#51060; &#51312;&#52824;&#54620; &#44163;&#51060;&#50632;&#45796;. &#51593;, &#47784;&#49464; &#50984;&#48277;&#51008; &#45796;&#47480; &#45224;&#51088;&#50752; &#44288;&#44228;&#47484; &#44032;&#51652; &#50500;&#45236;&#47484; &#45796;&#49884; &#48155;&#50500;&#46308;&#51060;&#51648; &#50506;&#46020;&#47197; &#44508;&#51221;&#54616;&#44256; &#51080;&#45796;(<a class='bible' href='#b5.24.4'>Deu 24:4</a> ). &#45908;&#44400;&#45796;&#45208; &#50500;&#46308;&#44284; &#46041;&#52840;&#54620; &#50668;&#51064;&#44284; &#45796;&#49884; &#46041;&#52840;&#54616;&#45716; &#54665;&#50948;&#45716; &#44032;&#51613;&#54620; &#44540;&#52828;&#49345;&#44036;&#51396;&#50640; &#54644;&#45817;&#46104;&#44592; &#46412;&#47928;&#50640;(<a class='bible' href='#b3.18.6-3.18.8'>Lev 18:6-8</a> ), &#45796;&#50967;&#51008; &#45908;&#45908;&#50865; &#48155;&#50500;&#46308;&#51068; &#49688; &#50630;&#50632;&#45796;. &#46384;&#46972;&#49436; &#45796;&#50967; &#50773;&#51008; &#51060;&#46308;&#51012; &#49457;&#48150;&#51004;&#47196; &#45236;&#50612; &#51923;&#51012; &#49688;&#46020; &#51080;&#50632;&#45796;. &#44536;&#47084;&#45208; &#45796;&#50967; &#50773;&#51008; &#51060; &#51068;&#50640; &#51080;&#50612;&#49436; &#51088;&#44592; &#51088;&#49888;&#50640;