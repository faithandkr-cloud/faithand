484; &#46020;&#50864;&#49884;&#45716; &#54616;&#45208;&#45784;'&#51060; &#48512;&#44033;&#46104;&#50612; &#51080;&#45796;. &#50500;&#47924;&#53948; &#51204;&#54980; &#47928;&#47589; &#44288;&#44228;&#47484; &#53685;&#54644;&#49436; &#48380; &#46412; &#48376;&#51208;&#51008; &#48520;&#47532;&#54620; &#49345;&#54889;&#50640; &#52376;&#54644; &#51080;&#45796;&#44256; &#54032;&#45800;&#54620; &#50500;&#49324; &#50773;&#51060; &#54616;&#45208;&#45784;&#51032; &#49457;&#54408;&#50640; &#51032;&#44144;, &#46020;&#50864;&#49900;&#51012; &#44396;&#54616;&#44256; &#51080;&#45716; &#44163;&#51060;&#46972; &#54616;&#44192;&#45796;. &#50668;&#44592;&#49436; &#54616;&#45208;&#45784;&#51032; &#49457;&#54408;&#51060;&#46976; &#48708;&#47197; &#51064;&#44036;&#51201;&#51004;&#47196; &#48520;&#44032;&#45733;&#54616;&#44172; &#48372;&#51060;&#45716; &#44221;&#50864;&#50640;&#46972;&#46020; &#45817;&#49888;&#51012; &#51032;&#51648;&#54616;&#44592;&#47564; &#54616;&#47732; &#45733;&#55176; &#46020;&#50752; &#44396;&#50896;&#54644; &#51452;&#49884;&#44256;&#50556;&#47560;&#45716; &#54616;&#45208;&#45784;&#51032; &#51088;&#48708;&#50752; &#44428;&#45733;&#51012; &#44032;&#47532;&#53416;&#45796;. </p><p><strong> &#9758;&#49324;&#46988;&#51004;&#47196; &#51452;&#47484; &#51060;&#44592;&#51648; &#47803;&#54616;&#44172; &#54616;&#50741;&#49548;&#49436;</strong> - &#50668;&#44592;&#49436; &#49324;&#46988;(* , &#50640;&#45432;&#49772;)&#51008; '&#44648;&#50612;&#51648;&#44592; &#49772;&#50868; &#51316;&#51116;', '&#51453;&#51012; &#49688;&#48150;&#50640; &#50630;&#45716; &#51316;&#51116;'&#46972;&#45716; &#53945;&#48268;&#54620; &#46907;&#51012; &#51648;&#45768;&#44256; &#51080;&#45716; &#45800;&#50612;&#51060;&#45796;. &#44536;&#47084;&#48064;&#47196; &#50500;&#49324;&#51032; &#51060; &#44592;&#46020;&#50640;&#45716; '&#51453;&#51012; &#49688;&#48150;&#50640; &#50630;&#45716; &#50976;&#54620;&#54620; &#51064;&#44036;&#51060; &#50689;&#50689;&#55176; &#51453;&#51648; &#50500;&#45768;&#54616;&#4