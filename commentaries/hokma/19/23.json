[{"fromverse":1,"toverse":1,"data":"<p> <strong> &#49457; &#44221;. [&#49884;.23.1]\r\n</p></strong><p>  &#51452;&#51228;1: [&#50689;&#54844;&#51032; &#47785;&#51088;&#46104;&#49888; &#50668;&#54840;&#50752;]\r\n</p><p>&#51452;&#51228;2: [&#49440;&#54620; &#47785;&#51088;]\r\n</p><p><strong> &#9758;&#50668;&#54840;&#50752;</strong> - &#45796;&#50967;&#51008; &#51060; &#54616;&#45208;&#45784;&#51032; &#51060;&#47492;&#51012; &#48376;&#49884;&#51032; &#52395;&#47672;&#47532;&#50640; &#46176;&#51004;&#47196;&#50024; &#50668;&#54840;&#50752;&#50640; &#45824;&#54620; &#44536;&#51032; &#51208;&#45824;&#51201;&#51064; &#49888;&#50521;&#51012; &#48372;&#50668;&#51452;&#44256; &#51080;&#45796;. &#46608;&#54620; `&#50668;&#54840;&#50752;'&#45716; &#48376;&#49884;&#51032; &#45824;&#51452;&#51228;&#51060;&#44592; &#46412;&#47928;&#50640; &#50526;&#50640; &#46160;&#50612;&#51276;&#51012; &#44163;&#51060;&#45796;(Craigie, Kidner). </p><p><strong> &#9758;&#45208;&#51032; &#47785;&#51088;&#49884;&#45768;</strong> - &#54616;&#45208;&#45784;&#51012; `&#47785;&#51088;'&#47196; &#48708;&#50976;&#54620; &#54364;&#54788;&#51008; &#45796;&#50967;&#50640; &#51032;&#54644; &#52376;&#51020; &#49324;&#50857;&#46108; &#44163;&#51060; &#50500;&#45768;&#45796;. &#51060; &#48708;&#50976;&#45716; &#51060;&#48120; &#50556;&#44273;&#50640; &#51032;&#54644; &#49324;&#50857;&#46104;&#50632;&#51004;&#47728;(<a class='bible' href='#b1.48.15'>Gen 48:15</a> ), &#44540;&#46041; &#51648;&#48169;&#51032; &#51060;&#48169; &#51333;&#44368;&#50640;&#49436;&#46020; &#49324;&#50857;&#46104;&#50632;&#45796;(Craigie). &#46608;&#54620; &#49457;&#51204; &#50696;&#48176;&#50640;&#49436;&#46020; &#51060; &#48708;&#50976;&#44032; &#50668;&#54840;&#50752;&#44760; &#51201;&#50857;&#46104;&#50632;&#45796;(80:1). &#46384;&#46972;&#49436; &#51060; &#48708;&#50976;&#45716; &#45817;&#49884; &#50976;&#47785; &#49324;&#54924;&#50688;&#45912; &#54036;&#47112;&#49828;&#54004;&#50640;&#49436;&#45716; &#45328;&#47532; &#50508;&#4714