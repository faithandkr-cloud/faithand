236; &#51452;&#44592;&#46020; &#54620;&#45796;. &#51060;&#45716; &#54616;&#45208;&#45784;&#44760;&#49436; &#50556;&#44273;&#44284;&#51032; &#50616;&#50557;&#51012; &#49888;&#49892;&#54616;&#44172; &#51060;&#54665;&#54616;&#49888; &#45936;&#49436; &#48708;&#47215;&#46104;&#50632;&#45796;(<a class='bible' href='#b1.28.15'>Gen 28:15</a> , Rawlinson). &#54620;&#54200;, '&#54616;&#45208;&#45784;&#51032; &#51060;&#47492;'&#51008; &#48376;&#49884;&#50640; &#47784;&#46160; &#49464; &#48264; &#50616;&#44553;&#46104;&#50632;&#45716;&#45936;(1,5,7&#51208;). &#51060; &#51060;&#47492;&#51008; &#49457;&#44221;&#50640;&#49436; &#54616;&#45208;&#45784; &#51088;&#49888;&#44284; &#46041;&#51068;&#49884;&#46108;&#45796;. &#54616;&#45208;&#45784;&#51008; &#51088;&#49888;&#51060; &#51076;&#51116;&#54616;&#49888; &#44275;&#50640;&#49436; &#51088;&#49888;&#51032; &#51060;&#47492;&#51012; &#47568;&#50432;&#54616;&#49512;&#51004;&#47728;(<a class='bible' href='#b5.12.5'>Deu 12:5</a> ,<a class='bible' href='#b5.12.21'>Deu 12:21</a> ;<a class='bible' href='#b11.14.21'>1Ki 14:21</a> ;<a class='bible' href='#b14.12.13'>2Ch 12:13</a> ), &#44536; &#51060;&#47492;&#51008; &#51088;&#49888;&#44284; &#45796;&#47484; &#48148; &#50630;&#51060; &#44144;&#47337;&#54616;&#44256; &#51316;&#44480;&#54620; &#44163;&#51060;&#45796;(111 :9;<a class='bible' href='#b13.17.24'>1Ch 17:24</a> , Lange, Rawlinson). &#54616;&#51648;&#47564; '&#54616;&#45208;&#45784;&#51032; &#51060;&#47492;'&#51008; &#52380;&#49345;&#50640;&#49436;&#48372;&#45796; &#51648;&#49345;&#50640;&#47196;&#51032; &#51076;&#51116;&#46972;&#45716; &#46021;&#53945;&#54620; &#51032;&#48120;&#47484; &#45236;&#54252;&#54616;&#44256; &#51080;&#45796;. &#51593;, &#50668;&#54840;&#50752; &#51088;&#49888;&#51008; &#54616;&#45720; &#48372;&#51340;&#50640; &#50505;&#50500; &#44228;&#49884;&#51648;&#47564; &#44536;&#51032; &#51060;&#47492;&#51008; &#51648;&#49345;&#50640;&#49436; &#44228;&#49884;&#46104;&#50612;&#51652; &#44163;&#51060;&#45796;(<a class='b